using UnityEngine;

/// <summary>Per-car engine voice data — the PULSE-TRAIN model (v2).
/// v1 (plain sine harmonics) was rejected by the user: it sounded like a
/// cheap electronic buzz. v2 builds each voice from:
///  - one exhaust pressure pulse per cylinder firing
///    (firing freq = rpm/60 x pulsesPerRev), each pulse a decaying burst
///    at resFreq (+2x/+3x harmonics) + a noise burst;
///  - intake roar, turbo whistle / supercharger whine layers;
///  - lift-off crackle (crackle == true);
///  - EV cars: no pulses, motor whine instead (motorWhineHz).
/// This file is DATA ONLY (no AudioSources). SoundManager reads it via
/// ForCar() / GetLegacy() and builds the runtime clips from it.
/// Order matches CarSelection.Cars exactly (indices 0-54).
/// Reference samples: ~/workspace/*-engine-sample-v2.wav (14 s each),
/// generated by /tmp/gen_car_samples_v2.py from the same parameters.
/// Design source: ~/workspace/CarSoundDesign.md.
/// SYNCED 2026-11-07 to the A/B-tuned params (/tmp/v3_rest_cars.py + ab_refs.py):
/// pulses/res/idle/redline/exhaustAmp/intake(+gain)/turbo/sc from the A/B pass;
/// h2/h3/h4 are the 3000-rpm BLENDED harmonic gains (h -> hHigh at w=3000/redline),
/// because the runtime clip is built at 3000 rpm; crackleLevel is the REFERENCE
/// crackle level (0-3). The full idle/high profiles live in the Python A/B params.
/// RE-SYNCED 2026-11-07 (per-condition pass + turbo-gap fix): h2/h3/h4 re-blended
/// from the refined Python params (cars 0-13 PC1/PC2, cars 16-54 rounds); added
/// turboWhistleGain (per-car whistle amp, normalised to the typical 0.06).</summary>
public static class EngineVoiceData
{
    public enum Aspiration { NA, Turbo, Supercharger, HybridTurbo, Hybrid, Electric }

    public struct EngineVoiceSpec
    {
        // Legacy game-loop values (SoundManager's 1 s loop + pitch curve).
        public float baseFreq, h2, h3, h4, h5, h6;
        // Pulse-train model (v2).
        public float pulsesPerRev;   // firing pulses per crank revolution
        public float resFreq;        // exhaust pulse resonance (Hz)
        public int idleRpm, redlineRpm, gearCount;
        public Aspiration aspiration;
        public float turboWhistleHz;       // 0 when no turbo
        public float superchargerWhineHz;  // 0 when no supercharger
        public float motorWhineHz;         // EV only
        public float exhaustAmp;           // 0-1.2, exhaust loudness
        public float interiorDamp;         // 0 raw - 1 silent cabin
        public int intakeLoHz, intakeHiHz; // intake roar band (Hz), A/B-tuned
        public float intakeGain;           // intake roar gain (0-0.35)
        public int crackleLevel;           // lift-off crackle 0 none - 3 strongest (ref level)
        public bool crackle;               // lift-off pops
        // Per-condition parameters (v3). 0 / false = derive from idle/redline
        // in SoundManager; only the fan favourites carry explicit values.
        public int coldFlareRpm;      // cold-start rpm flare after the catch
        public int cruiseRpm;         // steady cruising rpm
        public int downshiftBlipRpm;  // rpm the blip reaches on a downshift
        public int exhaustValveRpm;   // exhaust valve opens above this rpm (0 = none)
        public int turboStage2Rpm;    // second turbo / second pair spools here (0 = none)
        public bool idleLope;         // uneven lumpy idle (V8s, rotary)
        public bool blowOffValve;     // turbo blow-off "pssh" on lift-off
        public float secondaryFreqAmp;// LFA-style secondary combustion frequency layer
        public string character;           // one-line description
    }

    public static readonly EngineVoiceSpec[] Voices = new EngineVoiceSpec[]
    {
