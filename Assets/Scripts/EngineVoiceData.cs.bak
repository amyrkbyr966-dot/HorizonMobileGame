    /// <summary>Voice for a CarSelection index (clamped).</summary>
    public static EngineVoiceSpec ForCar(int index)
    {
        if (Voices == null || Voices.Length == 0) return default(EngineVoiceSpec);
        return Voices[Mathf.Clamp(index, 0, Voices.Length - 1)];
    }

    /// <summary>Legacy mapping for SoundManager's current EngineVoice
    /// (baseFreq + h2/h3/h4 + turbo/whine flags), so the existing clip
    /// builder keeps working until the pulse-train clip replaces it.</summary>
    public static void GetLegacy(int index, out float baseFreq, out float h2,
        out float h3, out float h4, out bool turbo, out bool whine)
    {
        EngineVoiceSpec v = ForCar(index);
        baseFreq = v.baseFreq; h2 = v.h2; h3 = v.h3; h4 = v.h4;
        turbo = v.aspiration == Aspiration.Turbo || v.aspiration == Aspiration.HybridTurbo;
        whine = v.aspiration == Aspiration.Supercharger || v.aspiration == Aspiration.Electric;
    }

    /// <summary>Firing frequency (Hz) at a given rpm — the pulse-train
    /// rate. EVs return 0 (no firing).</summary>
    public static float FiringFreqHz(int index, float rpm)
    {
        EngineVoiceSpec v = ForCar(index);
        if (v.aspiration == Aspiration.Electric) return 0f;
        return rpm / 60f * v.pulsesPerRev;
    }
}
